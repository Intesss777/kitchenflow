enum StaffEventType {
  lateness
  fine

  @@map("staff_event_type")
}

model StaffEmployee {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  name           String
  position       String
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "staff_employees_organization_id_fkey")
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "staff_employees_branch_id_fkey")
  events         StaffEvent[]

  @@index([organizationId, isActive], map: "staff_employees_organization_id_is_active_idx")
  @@index([branchId, isActive], map: "staff_employees_branch_id_is_active_idx")
  @@map("staff_employees")
}

model StaffEvent {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  branchId        String         @map("branch_id") @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  type            StaffEventType
  occurredOn      DateTime       @map("occurred_on") @db.Date
  arrivalTime     String?        @map("arrival_time")
  fineAmount      Decimal?       @map("fine_amount") @db.Decimal(14, 2)
  reason          String
  createdAt       DateTime       @default(now()) @map("created_at")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "staff_events_organization_id_fkey")
  branch          Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "staff_events_branch_id_fkey")
  employee        StaffEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, map: "staff_events_employee_id_fkey")
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, map: "staff_events_created_by_user_id_fkey")

  @@index([branchId, occurredOn], map: "staff_events_branch_id_occurred_on_idx")
  @@index([employeeId, occurredOn], map: "staff_events_employee_id_occurred_on_idx")
  @@index([createdByUserId], map: "staff_events_created_by_user_id_idx")
  @@map("staff_events")
}
