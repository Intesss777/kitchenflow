POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kitchenflow"

# Optional development seed users. Replace locally and never commit real values.
DEV_SEED_ADMIN_EMAIL="admin@example.com"
DEV_SEED_ADMIN_PASSWORD="change-me-admin"
DEV_SEED_USER_EMAIL="user@example.com"
DEV_SEED_USER_PASSWORD="change-me-user"
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Generate a unique value for every real environment.
JWT_SECRET="change-me-local-development-secret"

CORS_ORIGINS="http://localhost:5173"
WEBAPP_ORIGIN="http://localhost:5173"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
SESSION_ABSOLUTE_TTL_DAYS=90
SESSION_RETENTION_DAYS=30
AUTH_BODY_LIMIT_BYTES=65536
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_USERS_READ_RATE_LIMIT_MAX=60
ADMIN_USERS_READ_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_STORE="memory"
SHUTDOWN_GRACE_SECONDS=10

# Email is disabled by default for local development.
EMAIL_DELIVERY="disabled"
EMAIL_FROM=""
EMAIL_REPLY_TO=""
EMAIL_REQUEST_TIMEOUT_MS=10000
EMAIL_POSTBOX_ACCESS_KEY_ID=""
EMAIL_POSTBOX_SECRET_ACCESS_KEY=""
EMAIL_POSTBOX_ENDPOINT=""
EMAIL_POSTBOX_REGION=""
EMAIL_POSTBOX_CONFIGURATION_SET=""
EMAIL_RESEND_API_KEY=""
EMAIL_RESEND_ENDPOINT=""

TASK_OUTBOX_BATCH_LIMIT=50
TASK_OUTBOX_MAX_RUNTIME_MS=30000
TASK_OUTBOX_LEASE_STALE_MS=60000
TASK_OUTBOX_RETENTION_DAYS=30
TRUST_PROXY=false
COOKIE_SECURE=false

# Local private-file storage. Configure remote object storage only outside Git.
PRIVATE_STORAGE_DRIVER="filesystem"
PRIVATE_STORAGE_LOCAL_ROOT=".storage"
PRIVATE_STORAGE_REGION=""
PRIVATE_STORAGE_BUCKET=""
PRIVATE_STORAGE_ENDPOINT=""
PRIVATE_STORAGE_ACCESS_KEY_ID=""
PRIVATE_STORAGE_SECRET_ACCESS_KEY=""
PRIVATE_STORAGE_FORCE_PATH_STYLE=false
PRIVATE_STORAGE_ALLOW_REMOTE_ENDPOINT=false
PRIVATE_STORAGE_UPLOAD_MAX_BYTES=10485760
PRIVATE_STORAGE_UPLOAD_URL_TTL_SECONDS=900
PRIVATE_STORAGE_DOWNLOAD_URL_TTL_SECONDS=900

